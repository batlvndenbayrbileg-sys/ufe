# ─────────────────────────────────────────────────────────────
# Хийе — environment template. Copy to .env.local (never commit .env*).
# See docs/blueprint/11-system-architecture.md and 13-security.md.
# ─────────────────────────────────────────────────────────────

# App
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Separate registrable origin for student preview code (see 13-security.md §13.5).
# In dev this can be a localhost port; in prod it MUST be a different domain.
NEXT_PUBLIC_PREVIEW_ORIGIN=http://localhost:4000

# Database (docker-compose provides these defaults locally)
DATABASE_URL=postgresql://khiye:khiye@localhost:5432/khiye?schema=public

# Redis (cache, rate limit, queues)
REDIS_URL=redis://localhost:6379

# Object storage (MinIO locally, R2 in prod)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=khiye-dev
S3_ACCESS_KEY=khiye
S3_SECRET_KEY=khiye-secret

# Auth (generate with: openssl rand -base64 32)
AUTH_SECRET=change-me-in-dev-only
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# AI tutor (Anthropic) — not required for E0/MVP loop; tutor is flagged.
ANTHROPIC_API_KEY=

# Runner service (Tier-3; not used in the Tier-1 MVP)
RUNNER_URL=http://localhost:5001
RUNNER_SERVICE_TOKEN=

# Locale
DEFAULT_LOCALE=mn
