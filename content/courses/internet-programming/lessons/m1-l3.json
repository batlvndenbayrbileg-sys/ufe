  "tasks": [
    {
      "id": "m1-l3-t1",
      "order": 1,
      "title": {
        "mn": "Картаа бүтээ"
      },
      "statement": {
        "mn": "`.product-grid` дотор нэг бүтээгдэхүүний карт үүсгэ. Карт нь `<article class=\"product-card\">` байх ба дотор нь дараах 4 зүйл байна: зураг, нэр (`<h3>`), үнэ (`<p class=\"price\">`), `Сагсанд хийх` товч."
      },
      "requirements": [
        {
          "mn": "`<article class=\"product-card\">` байх"
        },
        {
          "mn": "`<img>`-д `alt` тайлбар байх"
        },
        {
          "mn": "Нэр нь `<h3>` дотор"
        },
        {
          "mn": "Үнэ нь `<p class=\"price\">` дотор, `₮` тэмдэгтэй"
        },
        {
          "mn": "`data-testid=\"add-to-cart\"` бүхий товч байх"
        }
      ],
      "expected": {
        "description": {
          "mn": "Preview дээр зураг (эвдэрсэн байж болно), нэр, үнэ, товч бүхий нэг карт харагдана."
        }
      },
      "targetFile": "index.html",
      "marker": "<!-- энд бичнэ үү -->",
      "checks": [
        {
          "id": "c1",
          "type": "dom.exists",
          "args": {
            "selector": "section.product-grid article.product-card",
            "min": 1
          },
          "onFail": {
            "mn": "`.product-grid` дотроос `product-card` class-тай `<article>` олдсонгүй. Class-ийн бичлэгээ (зураас -) шалгаарай."
          }
        },
        {
          "id": "c2",
          "type": "dom.attr",
          "args": {
            "selector": "article.product-card img",
            "name": "alt",
            "minLength": 2
          },
          "onFail": {
            "mn": "Картын `<img>`-д `alt` тайлбар алга. Зураг ачаалагдаагүй үед энэ текст харагдана — хоосон орхиж болохгүй."
          }
        },
        {
          "id": "c3",
          "type": "dom.exists",
          "args": {
            "selector": "article.product-card h3"
          },
          "onFail": {
            "mn": "Бүтээгдэхүүний нэрийг `<h3>` дотор бичээгүй байна."
          }
        },
        {
          "id": "c4",
          "type": "dom.text",
          "args": {
            "selector": "article.product-card p.price",
            "matches": "₮"
          },
          "onFail": {
            "mn": "Үнэ `<p class=\"price\">` дотор, `₮` тэмдэгттэй байх ёстой. Тэмдэгтийг хуулж болно: ₮"
          }
        },
        {
          "id": "c5",
          "type": "dom.exists",
          "args": {
            "selector": "article.product-card button[data-testid=\"add-to-cart\"]"
          },
          "onFail": {
            "mn": "`data-testid=\"add-to-cart\"` бүхий товч олдсонгүй. Энэ шинж дараагийн модульд JavaScript-д хэрэгтэй."
          }
        }
      ],
      "hints": [
        {
          "level": 1,
          "xpCost": 0,
          "text": {
            "mn": "`<article>` бол бие даасан агуулгыг илэрхийлэх элемент. Түүнд `class=\"product-card\"` өгнө."
          }
        },
        {
          "level": 2,
          "xpCost": 1,
          "text": {
            "mn": "Дотор нь дарааллаар: `<img src=\"...\" alt=\"...\">`, `<h3>Нэр</h3>`, `<p class=\"price\">₮ ...</p>`, `<button>`. Товчид `data-testid=\"add-to-cart\"` нэм."
          }
        },
        {
          "level": 3,
          "xpCost": 3,
          "text": {
            "mn": "Ингэж эхэл (үлдсэнийг нь өөрөө гүйцээ):"
          },
          "code": "<article class=\"product-card\">\n  <img src=\"images/deel.jpg\" alt=\"Монгол дээл\">\n  <h3>Монгол дээл</h3>\n  <!-- үнэ ба товч -->\n</article>"
        }
      ],
      "solution": {
        "patch": [
          {
            "op": "insertAfter",
            "path": "index.html",
            "anchor": "<!-- энд бичнэ үү -->",
            "content": "\n        <article class=\"product-card\">\n          <img src=\"images/deel.jpg\" alt=\"Монгол дээл\">\n          <h3>Монгол дээл</h3>\n          <p class=\"price\">₮ 129,000</p>\n          <button class=\"btn-add\" data-testid=\"add-to-cart\">Сагсанд хийх</button>\n        </article>"
          }
        ],
        "explanation": {
          "mn": "`<article>` нь бусад агуулгаас тусад нь ойлгогдох хэсэгт тохиромжтой. `data-testid` бол JavaScript болон тестээс элементийг олоход зориулсан тусгай шинж."
        },
        "xpPenalty": 12
      },
      "xp": 20,
      "estimatedMinutes": 12,
      "skills": [
        "html"
      ]
    }
  ],
