        "op": "create",
        "path": "index.html",
        "content": "<!doctype html>\n<html lang=\"mn\">\n  <head>\n    <meta charset=\"utf-8\" />\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n    <title>Shop.mn</title>\n    <link rel=\"stylesheet\" href=\"styles/main.css\">\n  </head>\n  <body>\n    <header class=\"topbar\">\n      <a class=\"logo\" href=\"index.html\">Shop.mn</a>\n      <button class=\"icon-btn\" data-testid=\"search-btn\" aria-label=\"Бараа хайх\">🔍</button>\n      <button class=\"icon-btn\" data-testid=\"cart-btn\" aria-label=\"Сагс харах\">\n        🛒<span class=\"cart-count\" data-testid=\"cart-count\">0</span>\n      </button>\n    </header>\n\n    <main id=\"main\">\n      <h1>Монгол дээл</h1>\n      <img class=\"divider\" src=\"images/divider.svg\" alt=\"\">\n      <!-- энд бичнэ үү -->\n\n      <article class=\"product-card\">\n        <img src=\"images/deel.jpg\" alt=\"Хар хөх өнгийн монгол дээл\">\n        <h3>Монгол дээл</h3>\n        <p class=\"price\" data-testid=\"price\">₮ 129,000</p>\n        <p class=\"stock out\" data-testid=\"stock\">●</p>\n        <div class=\"btn-add\" data-testid=\"add\" onclick=\"addToCart()\">Сагсанд хийх</div>\n      </article>\n\n      <form class=\"order-form\">\n        <h2>Захиалга</h2>\n        <label for=\"f-name\">Нэр</label>\n        <input id=\"f-name\" name=\"name\" type=\"text\" data-testid=\"f-name\" required aria-describedby=\"err-name\" aria-invalid=\"true\">\n        <p class=\"field-error\" id=\"err-name\" data-testid=\"err-name\">Нэрээ бичнэ үү.</p>\n        <label for=\"f-phone\">Утас</label>\n        <input id=\"f-phone\" name=\"phone\" type=\"tel\" data-testid=\"f-phone\" required>\n        <button type=\"submit\" class=\"btn-add\">Захиалах</button>\n      </form>\n\n      <p class=\"form-error\" data-testid=\"form-error\">Захиалга илгээгдсэнгүй.</p>\n    </main>\n\n    <script src=\"js/main.js\"></script>\n  </body>\n</html>\n"
      },
      {
        "op": "create",
        "path": "styles/main.css",
        "content": "body {\n  background-color: #ffffff;\n  color: #18181b;\n  font-family: system-ui, \"Segoe UI\", sans-serif;\n  line-height: 1.6;\n  padding: 16px;\n}\n\n.skip {\n  position: absolute;\n  left: -9999px;\n}\n\n.skip:focus {\n  left: 8px;\n  top: 8px;\n  background-color: #18181b;\n  color: #ffffff;\n  padding: 8px 12px;\n  border-radius: 6px;\n}\n\n.topbar {\n  display: flex;\n  align-items: center;\n  gap: 12px;\n  padding-bottom: 12px;\n  border-bottom: 1px solid #e4e4e7;\n}\n\n.logo {\n  font-weight: 700;\n  font-size: 20px;\n  color: #18181b;\n  text-decoration: none;\n  margin-right: auto;\n}\n\n.icon-btn {\n  background: none;\n  border: 1px solid #d4d4d8;\n  border-radius: 8px;\n  padding: 6px 10px;\n  font-size: 16px;\n  cursor: pointer;\n}\n\n.cart-count {\n  margin-left: 4px;\n  font-weight: 700;\n}\n\n.divider {\n  width: 100%;\n  height: 8px;\n}\n\nh1 { font-size: 28px; }\n\n.product-card img {\n  width: 100%;\n  max-width: 320px;\n  aspect-ratio: 4 / 3;\n  object-fit: cover;\n  border-radius: 10px;\n}\n\n.price {\n  color: #a9a9a9;\n  font-size: 18px;\n}\n\n.stock {\n  color: #f87171;\n  font-weight: 600;\n}\n\n.muted { color: #b4b4bb; }\n\n.btn-add {\n  display: inline-block;\n  background-color: #1d4ed8;\n  color: #ffffff;\n  padding: 10px 16px;\n  border: none;\n  border-radius: 6px;\n  cursor: pointer;\n  font-size: 15px;\n  font-family: inherit;\n}\n\n.order-form {\n  display: grid;\n  gap: 8px;\n  max-width: 320px;\n  margin-top: 24px;\n}\n\n.order-form input {\n  padding: 10px 12px;\n  border: 1px solid #d4d4d8;\n  border-radius: 8px;\n  font-size: 16px;\n}\n\n.field-error,\n.form-error {\n  color: #b91c1c;\n  font-size: 14px;\n  margin: 0;\n}\n"
      },
      {
        "op": "create",
        "path": "js/main.js",
        "content": "// Сагсны тоолуурыг шинэчилнэ. Энэ файлыг өөрчлөх шаардлагагүй.\n\nlet count = 0;\n\nfunction addToCart() {\n  count += 1;\n  document.querySelector('[data-testid=\"cart-count\"]').textContent = String(count);\n}\n\ndocument.querySelector('[data-testid=\"add\"]').addEventListener(\"click\", addToCart);\n"
      }
