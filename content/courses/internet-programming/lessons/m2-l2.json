  "tasks": [
    {
      "id": "m2-l2-t1",
      "order": 1,
      "title": {
        "mn": "Фонт ба гарчгийн хэмжээ"
      },
      "statement": {
        "mn": "`styles/main.css` дотор: 1) `body`-д `font-family` ба `line-height` (1.4-ээс их) өг. 2) `h1`-ийн `font-size`-ийг 28px-ээс их болго."
      },
      "requirements": [
        {
          "mn": "`body`-д `font-family` тодорхойлсон"
        },
        {
          "mn": "`body`-ийн `line-height` 1.4-ээс их"
        },
        {
          "mn": "`h1`-ийн `font-size` 28px-ээс их"
        }
      ],
      "expected": {
        "description": {
          "mn": "Бүх текст өөр фонтоор, гарчиг илүү том харагдана."
        }
      },
      "targetFile": "styles/main.css",
      "marker": "/* энд бичнэ үү */",
      "checks": [
        {
          "id": "c1",
          "type": "css.computed",
          "args": {
            "selector": "body",
            "prop": "font-family",
            "notEquals": ""
          },
          "onFail": {
            "mn": "`body`-д `font-family` өгөөгүй байна."
          }
        },
        {
          "id": "c2",
          "type": "css.numeric",
          "args": {
            "selector": "body",
            "prop": "line-height",
            "min": 1.4
          },
          "onFail": {
            "mn": "`body`-ийн `line-height` 1.4-ээс их байх ёстой. Кирилл үсэг нягт тул мөр хоорондын зай чухал."
          }
        },
        {
          "id": "c3",
          "type": "css.numeric",
          "args": {
            "selector": "h1",
            "prop": "font-size",
            "min": 28
          },
          "onFail": {
            "mn": "`h1`-ийн `font-size` 28px-ээс их байх ёстой. Одоо {actual}."
          }
        }
      ],
      "hints": [
        {
          "level": 1,
          "xpCost": 0,
          "text": {
            "mn": "Фонтыг `font-family`, үсгийн хэмжээг `font-size`, мөр хоорондын зайг `line-height` шинжээр өгнө."
          }
        },
        {
          "level": 2,
          "xpCost": 1,
          "text": {
            "mn": "`font-family`-д нэгээс олон фонт таслалаар зааглан бичдэг — эхнийх нь байхгүй бол дараагийнхыг ашиглана."
          }
        },
        {
          "level": 3,
          "xpCost": 3,
          "text": {
            "mn": "Бүтэц нь ийм, утгыг нь өөрөө сонго:"
          },
          "code": "body {\n  font-family: /* энд фонтоо бич */;\n  line-height: /* энд тоо */;\n}"
        }
      ],
      "solution": {
        "patch": [
          {
            "op": "insertAfter",
            "path": "styles/main.css",
            "anchor": "/* энд бичнэ үү */",
            "content": "\nbody {\n  font-family: system-ui, \"Segoe UI\", sans-serif;\n  line-height: 1.6;\n}\n\nh1 {\n  font-size: 36px;\n}"
          }
        ],
        "explanation": {
          "mn": "Фонт ба гарчгийн хэмжээ: CSS сонгогч нь аль элементэд загвар өгөхийг заана, `{ }` дотор шинж бүрийг `шинж: утга;` хэлбэрээр бичнэ."
        },
        "xpPenalty": 6
      },
