  "tasks": [
    {
      "id": "m3-l4-t1",
      "order": 1,
      "title": {
        "mn": "Header-ийг утсанд тохируулах"
      },
      "statement": {
        "mn": "Header-ийн суурь дүрэм одоо `flex-direction: column` (утсанд зориулсан). CSS-ийн төгсгөлд media query нэмээд, `768px`-ээс өргөн дэлгэцэд `header`-ийг `row` болго."
      },
      "requirements": [
        {
          "mn": "375px дээр `flex-direction: column`"
        },
        {
          "mn": "1024px дээр `flex-direction: row`"
        }
      ],
      "expected": {
        "description": {
          "mn": "Mobile горимд лого дээр, цэс доор; Desktop горимд хоёулаа нэг эгнээнд."
        }
      },
      "targetFile": "styles/main.css",
      "marker": "/* энд бичнэ үү */",
      "checks": [
        {
          "id": "c1",
          "type": "css.responsive",
          "args": {
            "viewport": {
              "width": 375
            },
            "then": [
              {
                "id": "m",
                "type": "css.computed",
                "args": {
                  "selector": "header",
                  "prop": "flex-direction",
                  "equals": "column"
                }
              }
            ]
          },
          "onFail": {
            "mn": "Утасны өргөнд header нь `column` хэвээр байх ёстой. Суурь дүрмээ бүү өөрчил."
          }
        },
        {
          "id": "c2",
          "type": "css.responsive",
          "args": {
            "viewport": {
              "width": 1024
            },
            "then": [
              {
                "id": "d",
                "type": "css.computed",
                "args": {
                  "selector": "header",
                  "prop": "flex-direction",
                  "equals": "row"
                }
              }
            ]
          },
          "onFail": {
            "mn": "Өргөн дэлгэцэд header нь `row` болох ёстой. `@media (min-width: 768px)` дотор `flex-direction: row` зааж өгсөн үү?"
          }
        }
      ],
      "hints": [
        {
          "level": 1,
          "xpCost": 0,
          "text": {
            "mn": "Өмнөх хичээл дээрх media query-тэй яг ижил бүтэц. Зөвхөн дотор нь өөр сонгогч, өөр шинж бичнэ."
          }
        },
        {
          "level": 2,
          "xpCost": 1,
          "text": {
            "mn": "`flex-direction` нь `row` (хэвтээ) эсвэл `column` (босоо) утга авна."
          }
        },
        {
          "level": 3,
          "xpCost": 3,
          "text": {
            "mn": "Бүтэц нь ийм, дотор талыг өөрөө гүйцээ:"
          },
          "code": "@media (min-width: 768px) {\n  header {\n    /* flex-direction-оо энд зааж өг */\n  }\n}"
        }
      ],
      "solution": {
        "patch": [
          {
            "op": "insertAfter",
            "path": "styles/main.css",
            "anchor": "/* энд бичнэ үү */",
            "content": "\n@media (min-width: 768px) {\n  header {\n    flex-direction: row;\n  }\n}"
          }
        ],
        "explanation": {
          "mn": "Нэг media query-г олон сонгогчид ашиглаж болно. Ихэвчлэн breakpoint-уудаа цөөхөн байлгаж, тухайн цэг дээр хэрэгтэй бүх өөрчлөлтөө нэг дор бичдэг."
        },
        "xpPenalty": 12
      },
      "xp": 20,
      "estimatedMinutes": 12,
      "skills": [
        "css",
        "responsive"
      ]
    }
  ],
