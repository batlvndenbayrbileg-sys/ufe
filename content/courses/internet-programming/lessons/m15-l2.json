        "content": "<!doctype html>\n<html lang=\"mn\">\n  <head>\n    <meta charset=\"utf-8\" />\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n    <title>Shop.mn</title>\n    <link rel=\"stylesheet\" href=\"styles/main.css\">\n  </head>\n  <body>\n    <header class=\"topbar\">\n      <a class=\"logo\" href=\"index.html\">Shop.mn</a>\n      <button class=\"icon-btn\" data-testid=\"search-btn\" aria-label=\"Бараа хайх\">🔍</button>\n      <button class=\"icon-btn\" data-testid=\"cart-btn\" aria-label=\"Сагс харах\">\n        🛒<span class=\"cart-count\" data-testid=\"cart-count\">0</span>\n      </button>\n    </header>\n\n    <main id=\"main\">\n      <h1>Монгол дээл</h1>\n      <img class=\"divider\" src=\"images/divider.svg\" alt=\"\">\n      <!-- энд бичнэ үү -->\n\n      <article class=\"product-card\">\n        <img src=\"images/deel.jpg\" alt=\"Хар хөх өнгийн монгол дээл\">\n        <h3>Монгол дээл</h3>\n        <p class=\"price\" data-testid=\"price\">₮ 129,000</p>\n        <p class=\"stock out\" data-testid=\"stock\">●</p>\n        <div class=\"btn-add\" data-testid=\"add\" onclick=\"addToCart()\">Сагсанд хийх</div>\n      </article>\n\n      <form class=\"order-form\">\n        <h2>Захиалга</h2>\n        <input name=\"name\" type=\"text\" placeholder=\"Нэр\" data-testid=\"f-name\">\n        <p class=\"field-error\" data-testid=\"err-name\">Нэрээ бичнэ үү.</p>\n        <input name=\"phone\" type=\"tel\" placeholder=\"Утас\" data-testid=\"f-phone\">\n        <button type=\"submit\" class=\"btn-add\">Захиалах</button>\n      </form>\n\n      <p class=\"form-error\" data-testid=\"form-error\">Захиалга илгээгдсэнгүй.</p>\n    </main>\n\n    <script src=\"js/main.js\"></script>\n  </body>\n</html>\n"
