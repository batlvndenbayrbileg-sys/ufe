        },
        {
          "mn": "`required`"
        },
        {
          "mn": "`aria-describedby`"
        },
        {
          "mn": "`placeholder` шошгыг орлохгүй"
        }
      ],
      "expected": {
        "description": {
          "mn": "Талбар бүр шошготой, алдааны мессеж нь талбартайгаа холбогдоно."
