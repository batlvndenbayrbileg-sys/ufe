        "content": "body {\n  background-color: #ffffff;\n  color: #18181b;\n  font-family: system-ui, \"Segoe UI\", sans-serif;\n  line-height: 1.6;\n  padding: 16px;\n}\n\n.skip {\n  position: absolute;\n  left: -9999px;\n}\n\n.skip:focus {\n  left: 8px;\n  top: 8px;\n  background-color: #18181b;\n  color: #ffffff;\n  padding: 8px 12px;\n  border-radius: 6px;\n}\n\n.topbar {\n  display: flex;\n  align-items: center;\n  gap: 12px;\n  padding-bottom: 12px;\n  border-bottom: 1px solid #e4e4e7;\n}\n\n.logo {\n  font-weight: 700;\n  font-size: 20px;\n  color: #18181b;\n  text-decoration: none;\n  margin-right: auto;\n}\n\n.icon-btn {\n  background: none;\n  border: 1px solid #d4d4d8;\n  border-radius: 8px;\n  padding: 6px 10px;\n  font-size: 16px;\n  cursor: pointer;\n}\n\n.cart-count {\n  margin-left: 4px;\n  font-weight: 700;\n}\n\n.divider {\n  width: 100%;\n  height: 8px;\n}\n\nh1 { font-size: 28px; }\n\n.product-card img {\n  width: 100%;\n  max-width: 320px;\n  aspect-ratio: 4 / 3;\n  object-fit: cover;\n  border-radius: 10px;\n}\n\n.price {\n  color: #a9a9a9;\n  font-size: 18px;\n}\n\n.stock {\n  color: #f87171;\n  font-weight: 600;\n}\n\n.muted { color: #b4b4bb; }\n\n.btn-add {\n  display: inline-block;\n  background-color: #1d4ed8;\n  color: #ffffff;\n  padding: 10px 16px;\n  border: none;\n  border-radius: 6px;\n  cursor: pointer;\n  font-size: 15px;\n  font-family: inherit;\n}\n\n.order-form {\n  display: grid;\n  gap: 8px;\n  max-width: 320px;\n  margin-top: 24px;\n}\n\n.order-form input {\n  padding: 10px 12px;\n  border: 1px solid #d4d4d8;\n  border-radius: 8px;\n  font-size: 16px;\n}\n\n.field-error,\n.form-error {\n  color: #b91c1c;\n  font-size: 14px;\n  margin: 0;\n}\n"
