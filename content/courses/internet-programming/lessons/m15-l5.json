        "content": "<!doctype html>\n<html lang=\"mn\">\n  <head>\n    <meta charset=\"utf-8\" />\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n    <title>Shop.mn</title>\n    <link rel=\"stylesheet\" href=\"styles/main.css\">\n  </head>\n  <body>\n    <a class=\"skip\" href=\"#main\">Үндсэн хэсэг рүү шилжих</a>\n    <header class=\"topbar\">\n      <a class=\"logo\" href=\"index.html\">Shop.mn</a>\n      <button class=\"icon-btn\" data-testid=\"search-btn\" aria-label=\"Бараа хайх\">🔍</button>\n      <button class=\"icon-btn\" data-testid=\"cart-btn\" aria-label=\"Сагс харах\">\n        🛒<span class=\"cart-count\" data-testid=\"cart-count\">0</span>\n      </button>\n    </header>\n\n    <main id=\"main\">\n      <h1>Монгол дээл</h1>\n      <img class=\"divider\" src=\"images/divider.svg\" alt=\"\">\n      <!-- энд бичнэ үү -->\n\n      <article class=\"product-card\">\n        <img src=\"images/deel.jpg\" alt=\"Хар хөх өнгийн монгол дээл\">\n        <h2>Монгол дээл</h2>\n        <p class=\"price\" data-testid=\"price\">₮ 129,000</p>\n        <p class=\"stock out\" data-testid=\"stock\"><span aria-hidden=\"true\">●</span> Дууссан</p>\n        <button class=\"btn-add\" data-testid=\"add\">Сагсанд хийх</button>\n      </article>\n\n      <form class=\"order-form\">\n        <h2>Захиалга</h2>\n        <label for=\"f-name\">Нэр</label>\n        <input id=\"f-name\" name=\"name\" type=\"text\" data-testid=\"f-name\" required aria-describedby=\"err-name\" aria-invalid=\"true\">\n        <p class=\"field-error\" id=\"err-name\" data-testid=\"err-name\">Нэрээ бичнэ үү.</p>\n        <label for=\"f-phone\">Утас</label>\n        <input id=\"f-phone\" name=\"phone\" type=\"tel\" data-testid=\"f-phone\" required>\n        <button type=\"submit\" class=\"btn-add\">Захиалах</button>\n      </form>\n\n      <p class=\"form-error\" data-testid=\"form-error\">Захиалга илгээгдсэнгүй.</p>\n    </main>\n\n    <script src=\"js/main.js\"></script>\n  </body>\n</html>\n"
