{
  "name": "khiye",
  "version": "0.1.0",
  "private": true,
  "description": "Хийе — interactive programming education for Mongolian students. Monorepo root.",
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:setup": "pnpm --filter @khiye/db exec prisma migrate deploy && pnpm --filter @khiye/db db:seed && pnpm --filter @khiye/content-sdk content sync ../../content/courses/internet-programming",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,json,md,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,mjs,json,md,css}\"",
    "clean": "turbo run clean && rimraf node_modules"
  },
  "devDependencies": {
    "@eslint/js": "9.18.0",
    "@types/node": "22.10.7",
    "eslint": "9.18.0",
    "globals": "15.14.0",
    "prettier": "3.4.2",
    "rimraf": "6.0.1",
    "turbo": "2.3.3",
    "typescript": "5.7.3",
    "typescript-eslint": "8.20.0"
  }
}
