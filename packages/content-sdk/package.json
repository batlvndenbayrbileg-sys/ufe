    "clean": "rimraf .turbo coverage"
  },
  "dependencies": {
    "@khiye/checkers": "workspace:*",
    "@khiye/db": "workspace:*",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@types/node": "22.10.7",
    "eslint": "9.18.0",
    "tsx": "4.19.2",
    "typescript": "5.7.3",
    "vitest": "2.1.8"
  }
}
